# Dezvoltare locală; copiază în .env.local. Niciun secret real în acest fișier.
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
ARTMASTER_STORAGE=local
ARTMASTER_DATA_DIR=.data
# Numai pentru verificarea unui build local/staging pe o singură mașină.
ARTMASTER_ALLOW_LOCAL_PRODUCTION=false

# Activează numai când gazda suprascrie antetul IP și îi cunoști contractul.
ARTMASTER_TRUST_PROXY=false
ARTMASTER_IP_HEADER=x-real-ip

# Producție: proiect Supabase real, cheile păstrate doar pe server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Minimum 32 caractere aleatorii; modul local le generează și păstrează privat.
ARTMASTER_FORM_SECRET=
ARTMASTER_SESSION_SECRET=

# Resend: domeniu de expediere verificat. Gol = fără notificări prin e-mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
QUOTE_NOTIFICATION_EMAIL=office@artmaster.md

# Proprietăți Google reale; opțional. Gol = fără analiză/verificare meta.
GA_MEASUREMENT_ID=
GSC_VERIFICATION=
